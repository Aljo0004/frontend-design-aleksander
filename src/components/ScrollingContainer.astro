---
const { cardContent } = Astro.props;
---

<ul class="full-width">
  {
    cardContent.map((card) => (
      <li>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
      </li>
    ))
  }
</ul>

<style>
  ul {
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 1rem;
    scroll-behavior: smooth;

    li {
      flex: 0 0 40%;
      scroll-snap-align: center;
      scroll-snap-stop: always;
      align-self: start;
      border-radius: 10px;
      padding: 2rem;
      display: flex;
      flex-direction: column;
      background: #ebebeb;
      color: #595566;
      /* justify-content: center; */

      h3 {
        font-weight: 700;
        font-size: 1.6rem;
      }
    }
  }

  /*
  lærers løsning
  ul {
  display:flex;
  overflow-x: auto;
  padding-inline: max(1rem, 50% - var(--content-width) / 2); 50% af viewport - halvdelen af content width (50rem).
  scroll-padding-inline: max(1rem, 50% - var(--content-width) / 2);
  }

  li {
  scroll-snap-align: start;
  flex: 1 0 400px;
  background: var(--card-background);
  color: var(card-text-color);
  padding: var(--card-padding);
  border-radius: var(--card-border-radius);
  }
  */
</style>
